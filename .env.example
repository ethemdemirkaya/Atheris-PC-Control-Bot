# Telegram bot token (BotFather'dan al)
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# Yetkili Telegram User ID'leri (virgulle ayir, en az 1 tane olmali)
# Kendi ID'ni ogrenmek icin: @userinfobot
ALLOWED_USER_IDS=123456789

# Log seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Rate limit: ayni kullanici penceresi (saniye) icinde maksimum komut sayisi
RATE_LIMIT_WINDOW=10
RATE_LIMIT_MAX=20

# Dosya islemlerinde izin verilen kok klasorler (virgulle ayir, bos = tum kullanici klasoru)
# Ornek: C:\Users\Username\Desktop,C:\Users\Username\Downloads
FILE_ALLOWED_ROOTS=

# Maksimum gonderilebilecek dosya boyutu (MB) - Telegram limiti 50MB
MAX_FILE_SIZE_MB=50

# /unlock komutu icin best-effort sifre. Bos birakilirsa /unlock sadece
# ekrani uyandirir ve swipe'i gecmeyi dener; sifre elle girilir.
# UYARI: Bot calistigi makinede plain text olarak durur — sadece kendi PC'nde
# kullanmayi planliyorsan ve repo gercekten public ise bos birak.
UNLOCK_PASSWORD=

# Gercek lock ekrani unlock'u icin LocalSystem servisi (bkz.
# SETUP_UNLOCK_SERVICE.md). Bu secret hem bot hem servis tarafindan
# okunur — istemcileri dogrulamak icin. Rastgele 32+ karakter ata.
UNLOCK_SERVICE_SECRET=
